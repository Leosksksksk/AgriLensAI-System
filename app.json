{
  "expo": {
    "name": "AgriLens AI",
    "slug": "agrilens-ai",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1B4330"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AgriLens AI needs access to your photos to analyze crop leaf health.",
          "cameraPermission": "AgriLens AI needs camera access to capture leaf images."
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c3941f92-ffaa-4510-aa9e-522a3857bb77"
      }
    },
    "android": {
      "package": "com.junrel.agrilensai",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": "1.0.0",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1B4330"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c3941f92-ffaa-4510-aa9e-522a3857bb77"
    },
    "ios": {
      "runtimeVersion": {
        "policy": "appVersion"
      }
    }
  }
}